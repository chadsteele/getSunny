# Public browser configuration
VITE_APP_NAME=App
VITE_ROOT_DOMAIN=example.com
VITE_COOKIE_DOMAIN=.example.com
VITE_APP_URL=https://app.example.com
VITE_SIBLING_APP_URL=https://admin.example.com
VITE_AUTH_LOGIN_URL=https://app.example.com
VITE_AUTH_LOGOUT_URL=https://app.example.com
VITE_COOKIE_NAME=sso_session

# Required name for the shared SSO contract. This client-consumer project never reads it.
# Do not expose a server-side secret through Vite; use AUTH_SECRET in the login owner.
VITE_AUTH_SECRET=replace-me-server-side-only

# Existing public client configuration
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me
VITE_STYTCH_PUBLIC_TOKEN=replace-me

# Existing server-only configuration
SUNNY_OPENAI_API_KEY=replace-me
VENICE_API_KEY=replace-me
DEEPGRAM_API_KEY=replace-me
STYTCH_PROJECT_ID=replace-me
STYTCH_SECRET=replace-me
STYTCH_API_URL=https://test.stytch.com
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
