{
  "name": "get-sunny",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"node --env-file=.env ./node_modules/netlify-cli/bin/run.js functions:serve --offline --functions netlify/functions --port 9999\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify:venice": "node --env-file=.env scripts/verify-venice.mjs",
    "format": "prettier --write \"src/**/*.{svelte,ts,css}\" \"netlify/functions/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,css}\" \"netlify/functions/**/*.mjs\""
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "^5.2.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "concurrently": "^9.2.5",
    "netlify-cli": "^23.15.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "openai": "^7.55.0"
  }
}
