{
  "name": "get-sunny",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"node --env-file=.env ./node_modules/netlify-cli/bin/run.js functions:serve --offline --functions netlify/functions --port 9999\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify:venice": "node --env-file=.env scripts/verify-venice.mjs",
    "format": "prettier --write \"src/**/*.{svelte,ts,css}\" \"netlify/functions/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,css}\" \"netlify/functions/**/*.mjs\""
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "concurrently": "^10.0.7",
    "netlify-cli": "^27.20.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.4.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "marked": "^18.3.0",
    "openai": "^7.64.0"
  }
}
